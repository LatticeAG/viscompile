{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticeag.dev/schemas/viscompile/transcript-v1.schema.json",
  "title": "VisCompile transcript v1",
  "description": "Recorded AI agent transcript accepted by VisCompile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "cases"],
  "properties": {
    "kind": {
      "const": "latticeag.viscompile.transcript"
    },
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "events"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": true,
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/tool_call"
        },
        {
          "$ref": "#/$defs/final"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "arguments"],
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": true
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "output"],
      "properties": {
        "type": {
          "const": "final"
        },
        "output": true
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "const": "error"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
